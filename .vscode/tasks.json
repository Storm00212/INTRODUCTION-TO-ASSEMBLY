{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build and Run x64 Assembly",
            "type": "shell",
            "command": "nasm -f win64 ${file} -o ${fileDirname}\\${fileBasenameNoExtension}.obj && gcc ${fileDirname}\\${fileBasenameNoExtension}.obj -o ${fileDirname}\\${fileBasenameNoExtension}.exe && ${fileDirname}\\${fileBasenameNoExtension}.exe",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
            "problemMatcher": []
        }
    ]
}
